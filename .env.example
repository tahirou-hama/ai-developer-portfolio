
# Server
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=ai_portfolio

# Admin Authentication
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash
JWT_SECRET=replace_with_a_long_random_secret

# Gmail API configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GMAIL_SENDER_EMAIL=your_gmail_address
CONTACT_NOTIFICATION_EMAIL=your_notification_email

# OpenAI (optional - AI assistant currently disconnected)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini

# Frontend API
VITE_API_BASE_URL=http://localhost:5000

# Frontend URL allowed to access the backend
CLIENT_URL=http://localhost:5173
